      "name": "1. Dueños",
      "item": [
        {
          "name": "Crear dueño",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/duenos",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "duenos"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"rut\": \"{{rut}}\",\n  \"nombre\": \"Valentina Soto\",\n  \"telefono\": \"+56911223344\",\n  \"email\": \"valentina.soto@correo.cl\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Genera un RUT válido (con dígito verificador) para no chocar con RUTs ya registrados",
                  "const cuerpo = Math.floor(10000000 + Math.random() * 89999999);",
                  "let suma = 0, mult = 2;",
                  "for (const d of String(cuerpo).split(\"\").reverse()) { suma += Number(d) * mult; mult = mult === 7 ? 2 : mult + 1; }",
                  "const r = 11 - (suma % 11);",
                  "const dv = r === 11 ? \"0\" : r === 10 ? \"K\" : String(r);",
                  "pm.collectionVariables.set(\"rut\", cuerpo + \"-\" + dv);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 201 Created\", () => pm.response.to.have.status(201));",
                  "const json = pm.response.json();",
                  "pm.test(\"Devuelve el dueño con id\", () => pm.expect(json.id).to.be.a(\"number\"));",
                  "pm.test(\"El RUT es el enviado\", () => pm.expect(json.rut).to.eql(pm.collectionVariables.get(\"rut\")));",
                  "pm.collectionVariables.set(\"duenoId\", pm.response.json().id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Listar dueños",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/duenos",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "duenos"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200 OK\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Incluye el dueño creado\", () => pm.expect(pm.response.json().map(d => d.id)).to.include(Number(pm.collectionVariables.get(\"duenoId\"))));"
                ]
              }
            }
          ]
        },
        {
          "name": "Obtener dueño por id",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/duenos/{{duenoId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "duenos",
                "{{duenoId}}"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200 OK\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Es el dueño pedido\", () => pm.expect(pm.response.json().id).to.eql(Number(pm.collectionVariables.get(\"duenoId\"))));"
                ]
              }
            }
          ]
        },
        {
          "name": "Actualizar dueño",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/duenos/{{duenoId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "duenos",
                "{{duenoId}}"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"rut\": \"{{rut}}\",\n  \"nombre\": \"Valentina Soto\",\n  \"telefono\": \"+56999887766\",\n  \"email\": \"vale.soto@correo.cl\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200 OK\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Teléfono actualizado\", () => pm.expect(pm.response.json().telefono).to.eql(\"+56999887766\"));"
                ]
              }
            }
          ]
        }
